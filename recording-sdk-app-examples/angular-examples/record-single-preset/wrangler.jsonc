{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "recording-app-record-single-preset-angular-production",
  "compatibility_date": "2024-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "env": {
    "staging": {
      "name": "recording-app-record-single-preset-angular-staging"
    },
    "production": {
      "name": "recording-app-record-single-preset-angular-production"
    }
  }
}
