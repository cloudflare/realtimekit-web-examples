{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "examples",
  "main": "./workers/app.ts",
  "compatibility_date": "2025-04-04",
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1
    }
  },
  "vars": {
    "REALTIMEKIT_BASE_URL": "realtime.cloudflare.com"
  },
  "env": {
    "staging": {
      "name": "examples-staging",
      "main": "./workers/app.ts",
      "vars": {
        "REALTIMEKIT_BASE_URL": "staging.realtime.cloudflare.com"
      }
    },
    "production": {
      "name": "examples",
      "main": "./workers/app.ts",
      "vars": {
        "REALTIMEKIT_BASE_URL": "realtime.cloudflare.com"
      }
    }
  }
}
